{
  "expo": {
    "name": "Tavin",
    "slug": "tavin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tavin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "eu.tavin.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "eu.tavin.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#465FE9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFF1F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#0A111C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#465FE9",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tavin folosește camera ca să fotografiezi facturi și bonuri pentru contabilul tău.",
          "photosPermission": "Tavin are nevoie de acces la poze ca să încarci documente pentru contabilul tău.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tavin folosește Face ID ca să îți protejeze datele firmei."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://finova-6eeu.onrender.com"
    }
  }
}
